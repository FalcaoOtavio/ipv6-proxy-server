[Unit]
Description=IPv6 proxy management API
Wants=network-online.target
After=network-online.target
# RestartSec=3: allow ~1 min of retries at boot instead of the 5/10 s default.
StartLimitIntervalSec=300
StartLimitBurst=10
# Proxies run as ipv6-proxy@<port>.service, outside this unit's cgroup; no
# PartOf/BindsTo either way, so restarting the API never stops them.

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ipv6-proxy-server
EnvironmentFile=/etc/ipv6-proxy-api.env
ExecStart=/opt/ipv6-proxy-server/.venv/bin/uvicorn proxy_api.app:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=30
UMask=0077
StateDirectory=ipv6-proxy-api
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/ipv6-proxy-api
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SETUID CAP_SETGID

[Install]
WantedBy=multi-user.target
