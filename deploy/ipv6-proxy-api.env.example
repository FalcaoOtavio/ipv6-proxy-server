PROXY_IPV6_SUBNET=2001:db8:1234::/64
PROXY_BIND_IPV4=192.0.2.10
PROXY_INTERFACE=eth0
PROXY_API_TOKEN=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32
PROXY_PORT_START=30000
PROXY_PORT_END=39999
PROXY_DATA_DIR=/var/lib/ipv6-proxy-api
PROXY_3PROXY_BINARY=/usr/local/bin/3proxy
# systemd (default): each proxy is ipv6-proxy@<port>.service; requires
# PROXY_DATA_DIR=/var/lib/ipv6-proxy-api. local: detached processes, dev/tests only.
PROXY_SUPERVISOR=systemd
# Max proxies per POST /proxies/batch (1..10000).
PROXY_BATCH_MAX=1000
# Refuse proxy destinations on loopback, ::ffff:0:0/96, fe80::/10, fc00::/7,
# ff00::/8 and the proxy subnet itself (SSRF to the host). Keep true in
# production; false exists only for tests that use loopback as target/egress.
PROXY_BLOCK_PRIVATE_DESTINATIONS=true
