# One 3proxy per proxy port: %i is the port. Managed by ipv6-proxy-api, which
# only ever starts/stops/restarts the instance it is mutating. Deliberately not
# PartOf/BindsTo the API: restarting or upgrading the API leaves proxies serving.
[Unit]
Description=IPv6 proxy instance on port %i (3proxy)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/var/lib/ipv6-proxy-api/proxies/%i.cfg
# Default limit (5 starts/10 s) vs RestartSec=2: a proxy failing while the
# network or its address settles at boot would give up for good after ~10 s.
# 10 attempts per 5 min keeps retrying ~1 min, then stops a real crash loop.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
# '+' runs only this step with full privileges: restore this instance's own
# /128 (lost on reboot) before 3proxy egresses from it. Refuses unowned addresses.
ExecStartPre=+/opt/ipv6-proxy-server/.venv/bin/python /opt/ipv6-proxy-server/proxy_api/instance_address.py %i
ExecStart=/usr/local/bin/3proxy /var/lib/ipv6-proxy-api/proxies/%i.cfg
Restart=on-failure
RestartSec=2
KillMode=control-group
# 3proxy exits at once on SIGINT; on SIGTERM it lingers ~5 s in its own loop,
# which every edit/rotate/delete of this instance would pay. SIGKILL after 3 s.
KillSignal=SIGINT
TimeoutStopSec=3
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/var/lib/ipv6-proxy-api/proxies
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Kernel-level SSRF backstop (ADR 0007), TCP and UDP alike, independent of the
# 3proxy ACL: host loopback, IPv4-mapped, link-local, ULA and multicast IPv6.
# IPv4 is untouched, so clients reaching -i<bind_ipv4> are never affected. The
# own subnet is not listed (a static unit cannot know it); the per-instance
# 3proxy "deny" ACL covers it. Needs cgroup v2 + BPF; ignored with a warning otherwise.
IPAddressDeny=::/128 ::1/128 ::ffff:0:0/96 fe80::/10 fc00::/7 ff00::/8
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
