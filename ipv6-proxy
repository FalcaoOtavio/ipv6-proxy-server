#!/usr/bin/python3
# ipv6-proxy-api-client
"""Command-line client for the local IPv6 Proxy Server API."""

import argparse
import getpass
import ipaddress
import http.client
import json
import os
import re
import stat
import sys
import tempfile
import urllib.error
import urllib.request
import warnings
from pathlib import Path

API_URL = "http://127.0.0.1:8000"
ENV_FILE = Path("/etc/ipv6-proxy-api.env")
# Allow all 64,512 supported ports, including maximum-length view fields.
MAX_BODY = 16 * 1024 * 1024
MAX_ENV = 64 * 1024
# Only operations on an existing port touch live sessions (per-port 3proxy,
# proven by tests/test_isolation_3proxy.py); create/batch disrupt nothing.
PORT_WARNING = "Esta operacao reinicia somente o 3proxy da porta afetada e desconecta as sessoes dessa porta."
MAX_COUNT = 64512
FORMATS = ("ipv4:port:user:pass", "text", "json")
ID_RE = re.compile(r"^[0-9a-f]{32}$")
USERNAME_RE = re.compile(r"^[A-Za-z0-9_.-]{1,64}$")
PASSWORD_RE = re.compile(r"^[A-Za-z0-9_.!@%+=-]{1,128}$")


class CliError(Exception):
    def __init__(self, message, exit_code):
        super().__init__(message)
        self.exit_code = exit_code


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


class Parser(argparse.ArgumentParser):
    """No prefix matching and no echo of unknown arguments: a mistyped
    "--password secret" must neither become --password-stdin nor land in stderr."""

    def __init__(self, *args, **kwargs):
        super().__init__(*args, allow_abbrev=False, **kwargs)

    def error(self, message):
        if message.startswith("unrecognized arguments"):
            message = "argumentos nao reconhecidos (valores omitidos); senhas nunca sao aceitas em argumentos"
        super().error(message)

def build_parser():
    parser = Parser(
        prog="ipv6-proxy",
        description="Gerencia proxies pelo mesmo servico da API local.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    list_parser = subparsers.add_parser("list", help="Lista os proxies")
    add_output(list_parser)

    create = subparsers.add_parser("create", help="Cria um proxy")
    create.add_argument("--port", type=port, help="Porta TCP; omita para usar a primeira livre")
    create.add_argument("--protocol", choices=("http", "socks5"), default="http")
    create.add_argument("--username", help="Usuario do proxy")
    create.add_argument(
        "--password-stdin",
        action="store_true",
        help="Le a senha de uma unica linha da entrada padrao (requer --yes)",
    )
    add_mutation_options(create)
    add_output(create)

    rotate = subparsers.add_parser("rotate", help="Troca somente o IPv6 de uma porta")
    rotate.add_argument("port", type=port)
    add_mutation_options(rotate)
    add_output(rotate)

    batch = subparsers.add_parser("batch", help="Cria proxies em lote")
    batch.add_argument("-c", "--proxy-count", type=count, help=f"Quantidade de proxies (1-{MAX_COUNT})")
    batch.add_argument("--start-port", type=port, help="Primeira porta candidata; portas ocupadas sao puladas")
    batch.add_argument("-t", "--protocol", choices=("http", "socks5"))
    auth = batch.add_mutually_exclusive_group()
    auth.add_argument("--random", action="store_true",
                      help="Senha aleatoria por proxy; -u vira prefixo do usuario (<prefixo><porta>)")
    auth.add_argument("--no-auth", action="store_true", help="Proxies sem autenticacao")
    batch.add_argument("-u", "--username", help="Usuario comum (ou prefixo com --random)")
    batch.add_argument("--password-stdin", action="store_true",
                       help="Le a senha comum de uma linha da entrada padrao (requer --yes)")
    batch.add_argument("--partial", action="store_true", help="Mantem os criados se algum falhar")
    add_file_options(batch)
    add_mutation_options(batch)

    edit = subparsers.add_parser("edit", help="Edita porta, protocolo ou credenciais de um proxy")
    edit.add_argument("port", type=port)
    edit.add_argument("--new-port", type=port, help="Nova porta")
    edit.add_argument("-t", "--protocol", choices=("http", "socks5"))
    edit_auth = edit.add_mutually_exclusive_group()
    edit_auth.add_argument("-u", "--username", help="Novo usuario (senha sem eco ou --password-stdin)")
    edit_auth.add_argument("--no-auth", action="store_true", help="Remove a autenticacao")
    edit.add_argument("--password-stdin", action="store_true",
                      help="Le a nova senha de uma linha da entrada padrao (requer --yes)")
    add_mutation_options(edit)
    add_output(edit)

    export = subparsers.add_parser("export", help="Exporta a lista existente (sem senhas)")
    add_file_options(export)

    delete = subparsers.add_parser("delete", help="Remove um proxy")
    delete.add_argument("port", type=port)
    add_mutation_options(delete)
    add_output(delete)
    return parser


def add_output(parser):
    parser.add_argument("--output", choices=("table", "json"), default="table")


def add_mutation_options(parser):
    parser.add_argument("--yes", action="store_true", help="Confirma sem perguntar (modo nao interativo)")

def add_file_options(parser):
    parser.add_argument("--format", choices=FORMATS, default="ipv4:port:user:pass",
                        help="Formato da lista (padrao IPv4:porta:usuario:senha)")
    parser.add_argument("-f", "--output-file", help="Grava a lista neste arquivo (modo 0600) em vez do stdout")
    parser.add_argument("--force", action="store_true", help="Substitui o arquivo de saida se existir")

def count(value):
    try:
        parsed = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("a quantidade deve ser um numero inteiro") from exc
    if not 1 <= parsed <= MAX_COUNT:
        raise argparse.ArgumentTypeError(f"a quantidade deve estar entre 1 e {MAX_COUNT}")
    return parsed


def port(value):
    try:
        parsed = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("a porta deve ser um numero inteiro") from exc
    if not 1024 <= parsed <= 65535:
        raise argparse.ArgumentTypeError("a porta deve estar entre 1024 e 65535")
    return parsed


def load_token(path=ENV_FILE, expected_uid=0):
    flags = os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as exc:
        raise CliError(f"Nao foi possivel ler {path}; execute com sudo e verifique a instalacao.", 3) from exc
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            raise CliError(f"Arquivo de configuracao inseguro: {path} nao e um arquivo regular.", 3)
        if metadata.st_uid != expected_uid or metadata.st_mode & 0o077:
            raise CliError(f"Arquivo de configuracao inseguro: {path} deve pertencer ao root e usar modo 0600.", 3)
        if metadata.st_size > MAX_ENV:
            raise CliError(f"Arquivo de configuracao excede {MAX_ENV} bytes.", 3)
        chunks = []
        total = 0
        while True:
            chunk = os.read(descriptor, min(8192, MAX_ENV + 1 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
            if total > MAX_ENV:
                raise CliError(f"Arquivo de configuracao excede {MAX_ENV} bytes.", 3)
    except OSError as exc:
        raise CliError("Falha ao ler o arquivo de configuracao.", 3) from exc
    finally:
        os.close(descriptor)

    try:
        text = b"".join(chunks).decode("ascii")
    except UnicodeDecodeError as exc:
        raise CliError("Arquivo de configuracao deve conter somente ASCII.", 3) from exc

    values = {}
    for number, line in enumerate(text.splitlines(), 1):
        if not line.strip() or line.lstrip().startswith(("#", ";")):
            continue
        if "=" not in line:
            raise CliError(f"Linha {number} invalida no arquivo de configuracao.", 3)
        name, value = line.split("=", 1)
        if not re.fullmatch(r"[A-Z][A-Z0-9_]*", name) or not value:
            raise CliError(f"Linha {number} invalida no arquivo de configuracao.", 3)
        if name in values:
            raise CliError(f"Variavel duplicada no arquivo de configuracao: {name}.", 3)
        if any(ord(character) < 33 or ord(character) > 126 for character in value):
            raise CliError(f"Valor invalido para {name} no arquivo de configuracao.", 3)
        values[name] = value

    token = values.get("PROXY_API_TOKEN", "")
    if len(token) < 32:
        raise CliError("PROXY_API_TOKEN ausente ou curto no arquivo de configuracao.", 3)
    return token


def confirm(args, stdin, stderr, warning=PORT_WARNING):
    if warning:
        print(warning, file=stderr)
    if args.yes:
        return
    if not stdin.isatty():
        raise CliError("Use --yes para confirmar uma alteracao sem terminal interativo.", 2)
    print("Continuar? [y/N] ", end="", file=stderr, flush=True)
    if stdin.readline().strip().lower() not in {"y", "yes", "s", "sim"}:
        raise CliError("Operacao cancelada.", 2)


def read_password(args, stdin):
    if args.username is None:
        if args.password_stdin:
            raise CliError("--password-stdin exige --username.", 2)
        return None
    if not USERNAME_RE.fullmatch(args.username):
        raise CliError("Username deve ter 1-64 caracteres: letras, numeros, _, . ou -.", 2)
    if args.password_stdin:
        if not args.yes:
            raise CliError("--password-stdin exige --yes; a entrada padrao esta reservada para a senha.", 2)
        first = stdin.readline(130)
        extra = stdin.read(1)
        if extra or not first.endswith(("\n", "\r")):
            raise CliError("A senha na entrada padrao deve ocupar exatamente uma linha.", 2)
        password = first.rstrip("\r\n")
    else:
        if not stdin.isatty():
            raise CliError("Sem terminal: use --password-stdin com --yes para fornecer a senha.", 2)
        try:
            # getpass must never fall back to an echoed read from stdin.
            with warnings.catch_warnings():
                warnings.simplefilter("error", getpass.GetPassWarning)
                password = getpass.getpass("Senha do proxy: ")
        except (getpass.GetPassWarning, EOFError, OSError) as exc:
            raise CliError("Nao foi possivel ler a senha sem eco; use --password-stdin com --yes.", 2) from exc
    if not PASSWORD_RE.fullmatch(password):
        raise CliError("Senha deve ter 1-128 caracteres permitidos: letras, numeros, _ . ! @ % + = -.", 2)
    return password


def request(method, path, token, payload=None, opener=None, headers=None):
    data = None if payload is None else json.dumps(payload, separators=(",", ":")).encode("ascii")
    headers = {**(headers or {}), "Authorization": "Bearer " + token, "Accept": "application/json"}
    if data is not None:
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(API_URL + path, data=data, headers=headers, method=method)
    client = opener or urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
    try:
        with client.open(req, timeout=60) as response:
            status_code = response.status
            body = response.read(MAX_BODY + 1)
    except urllib.error.HTTPError as exc:
        # Error bodies can reflect credentials in detail/msg/loc/input. Do not
        # render or parse them, even when they look like validation messages.
        exc.close()
        raise_api_error(exc.code)
    except (urllib.error.URLError, TimeoutError, OSError, http.client.HTTPException) as exc:
        message = "Falha de comunicacao com a API local"
        if method != "GET":
            message += "; o resultado pode ser desconhecido. Execute 'sudo ipv6-proxy list' antes de tentar novamente"
        raise CliError(message + ".", 6) from exc

    if len(body) > MAX_BODY:
        raise CliError("Resposta da API excedeu o limite permitido.", 5)
    return status_code, body


def raise_api_error(status_code):
    descriptions = {
        401: "token invalido ou ausente",
        404: "proxy nao encontrado",
        409: "conflito de porta, credenciais ou pool esgotado",
        412: "o proxy mudou desde a leitura; consulte 'list' e tente novamente",
        422: "entrada invalida; verifique os argumentos e a faixa de portas configurada",
        503: "servico indisponivel; consulte os logs da API",
    }
    message = f"API retornou HTTP {status_code}"
    if status_code in descriptions:
        message += ": " + descriptions[status_code]
    if status_code == 401:
        raise CliError(message, 3)
    if 400 <= status_code < 500:
        raise CliError(message, 4)
    raise CliError(message, 5)

def decode_json(body):
    if len(body) > MAX_BODY:
        raise CliError("Resposta da API excedeu o limite permitido.", 5)
    try:
        return json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, ValueError, RecursionError) as exc:
        raise CliError("API retornou JSON invalido.", 5) from exc


def proxy_view(value):
    if not isinstance(value, dict):
        raise CliError("API retornou um proxy invalido.", 5)
    required = {"port", "protocol", "ipv4", "ipv6", "username"}
    if not required.issubset(value):
        raise CliError("API retornou um proxy incompleto.", 5)
    item_port = value["port"]
    username = value["username"]
    if isinstance(item_port, bool) or not isinstance(item_port, int) or not 1024 <= item_port <= 65535:
        raise CliError("API retornou uma porta invalida.", 5)
    if not isinstance(value["protocol"], str) or value["protocol"] not in {"http", "socks5"}:
        raise CliError("API retornou um protocolo invalido.", 5)
    if username is not None and (not isinstance(username, str) or not USERNAME_RE.fullmatch(username)):
        raise CliError("API retornou um username invalido.", 5)
    if (not isinstance(value["ipv4"], str) or not isinstance(value["ipv6"], str)
            or "%" in value["ipv6"]):
        raise CliError("API retornou um endereco IP invalido.", 5)
    try:
        ipv4 = str(ipaddress.IPv4Address(value["ipv4"]))
        ipv6 = str(ipaddress.IPv6Address(value["ipv6"]))
    except (ipaddress.AddressValueError, TypeError) as exc:
        raise CliError("API retornou um endereco IP invalido.", 5) from exc
    return {"port": item_port, "protocol": value["protocol"], "ipv4": ipv4,
            "ipv6": ipv6, "username": username}

def batch_view(decoded):
    if not isinstance(decoded, dict) or not isinstance(decoded.get("created"), list) \
            or not isinstance(decoded.get("failed"), list):
        raise CliError("API retornou um lote invalido.", 5)
    created = []
    for item in decoded["created"]:
        view = proxy_view(item)
        password = item.get("password")
        if password is not None and (not isinstance(password, str) or not PASSWORD_RE.fullmatch(password)):
            raise CliError("API retornou uma senha invalida.", 5)
        created.append({**view, "password": password})
    failed = []
    for item in decoded["failed"]:
        failed_port = item.get("port") if isinstance(item, dict) else None
        if isinstance(failed_port, bool) or not isinstance(failed_port, int) or not 1024 <= failed_port <= 65535:
            raise CliError("API retornou uma falha de lote invalida.", 5)
        failed.append(failed_port)
    return created, failed


def parse_response(command, status_code, body, requested_port=None):
    expected = {"list": 200, "create": 201, "rotate": 200, "delete": 204}[command]
    if status_code != expected:
        raise CliError(f"API retornou HTTP {status_code}; esperado {expected}.", 5)
    if command == "delete":
        if body:
            raise CliError("API retornou conteudo inesperado ao excluir.", 5)
        return {"deleted": True, "port": requested_port}
    decoded = decode_json(body)
    if command == "list":
        if not isinstance(decoded, list):
            raise CliError("API retornou uma lista invalida.", 5)
        return [proxy_view(item) for item in decoded]
    return proxy_view(decoded)


def render(command, value, output, stdout):
    if output == "json":
        json.dump(value, stdout, ensure_ascii=True, separators=(",", ":"))
        stdout.write("\n")
        return
    if command == "delete":
        print(f"Proxy da porta {value['port']} removido.", file=stdout)
        return
    stdout.write(table(value if command == "list" else [value]))

def table(records):
    if not records:
        return "Nenhum proxy.\n"
    rows = [["PORTA", "PROTOCOLO", "IPV4", "IPV6", "USUARIO"]]
    rows.extend([[str(item["port"]), item["protocol"], item["ipv4"], item["ipv6"],
                  item["username"] or "-"] for item in records])
    if any(item.get("password") for item in records):
        rows[0].append("SENHA")
        for row, item in zip(rows[1:], records):
            row.append(item.get("password") or "-")
    widths = [max(len(row[index]) for row in rows) for index in range(len(rows[0]))]
    return "".join("  ".join(cell.ljust(widths[index]) for index, cell in enumerate(row)).rstrip() + "\n"
                   for row in rows)


def proxy_line(item):
    """IPv4:porta[:usuario[:senha]]; fields the CLI does not have are omitted, never invented."""
    fields = [item["ipv4"], str(item["port"])]
    if item["username"]:
        fields.append(item["username"])
        if item.get("password"):
            fields.append(item["password"])
    return ":".join(fields)

def format_list(records, fmt):
    if fmt == "json":
        return json.dumps(records, ensure_ascii=True, separators=(",", ":")) + "\n"
    if fmt == "text":
        return table(records)
    return "".join(proxy_line(item) + "\n" for item in records)

class OutputFile:
    """Credential list file: 0600, never follows a symlink, never clobbers without --force.

    Opened before the API call so a bad path cannot lose one-time passwords."""

    def __init__(self, path, force):
        self.path = Path(path)
        self.temp = None
        try:
            if force:
                if self.path.is_dir():
                    raise CliError(f"{self.path} e um diretorio.", 2)
                descriptor, self.temp = tempfile.mkstemp(prefix=".ipv6-proxy-", dir=self.path.parent or ".")
            else:
                flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
                descriptor = os.open(self.path, flags, 0o600)
            os.fchmod(descriptor, 0o600)
        except FileExistsError as exc:
            raise CliError(f"{self.path} ja existe; use --force para substituir.", 2) from exc
        except OSError as exc:
            raise CliError(f"Nao foi possivel criar {self.path}: {exc.strerror}.", 2) from exc
        self.file = os.fdopen(descriptor, "w", encoding="ascii")

    def commit(self, text):
        try:
            with self.file:
                self.file.write(text)
                self.file.flush()
                os.fsync(self.file.fileno())
            if self.temp:
                os.replace(self.temp, self.path)
        except OSError as exc:
            raise CliError(f"Falha ao gravar {self.path}: {exc.strerror}.", 5) from exc

    def discard(self):
        self.file.close()
        os.unlink(self.temp or self.path)

def emit(records, args, stdout, stderr, output_file=None):
    text = format_list(records, args.format)
    if output_file:
        output_file.commit(text)
        print(f"Lista gravada em {output_file.path} (modo 0600).", file=stderr)
    else:
        stdout.write(text)

def ask(stdin, stderr, question, default=None, parse=str):
    """Interactive question in PT-BR; repeats until the answer parses."""
    suffix = f" [{default}]" if default is not None else ""
    while True:
        print(f"{question}{suffix}: ", end="", file=stderr, flush=True)
        line = stdin.readline()
        if not line:
            raise CliError("Operacao cancelada.", 2)
        answer = line.strip() or default
        if answer is None:
            continue
        try:
            return parse(str(answer))
        except (argparse.ArgumentTypeError, ValueError) as exc:
            print(f"Valor invalido: {exc}", file=stderr)

def choice(*options):
    def parse(value):
        if value not in options:
            raise ValueError("escolha " + ", ".join(options))
        return value
    return parse

def optional_port(value):
    return None if value == "auto" else port(value)

def interactive_batch(args, stdin, stderr):
    """Fill only the missing parameters; flags already given are kept."""
    if args.proxy_count is None:
        args.proxy_count = ask(stdin, stderr, "Quantidade de proxies", parse=count)
    if args.start_port is None:
        args.start_port = ask(stdin, stderr, "Porta inicial (auto = inicio da faixa)", "auto", optional_port)
    if args.protocol is None:
        args.protocol = ask(stdin, stderr, "Protocolo (http/socks5)", "http", choice("http", "socks5"))
    if not (args.random or args.no_auth or args.username):
        mode = ask(stdin, stderr, "Credenciais (comum/aleatoria/nenhuma)", "aleatoria",
                   choice("comum", "aleatoria", "nenhuma"))
        args.random, args.no_auth = mode == "aleatoria", mode == "nenhuma"
        if mode == "comum":
            args.username = ask(stdin, stderr, "Usuario")
        elif args.random:
            args.username = ask(stdin, stderr, "Prefixo do usuario", "u")
    if args.output_file is None:
        target = ask(stdin, stderr, "Arquivo de saida (- = tela)", "-")
        args.output_file = None if target == "-" else target

def batch_payload(args, stdin, stderr):
    interactive = not args.yes and stdin.isatty()
    if interactive:
        interactive_batch(args, stdin, stderr)
    if args.proxy_count is None:
        raise CliError("Informe -c/--proxy-count (ou rode em terminal para o modo interativo).", 2)
    if not (args.random or args.no_auth or args.username):
        raise CliError("Escolha as credenciais: -u/--username (comum), --random ou --no-auth.", 2)
    if args.no_auth and (args.username or args.password_stdin):
        raise CliError("--no-auth nao aceita usuario ou senha.", 2)
    payload = {"count": args.proxy_count, "protocol": args.protocol or "http", "partial": args.partial}
    if args.start_port is not None:
        payload["start_port"] = args.start_port
    if args.random:
        if args.password_stdin:
            raise CliError("--random gera as senhas; nao use --password-stdin.", 2)
        payload["credentials"] = "random"
        if args.username:
            # The API appends the port (up to 5 digits) to the 64-char username.
            if not USERNAME_RE.fullmatch(args.username) or len(args.username) > 58:
                raise CliError("Prefixo deve ter 1-58 caracteres: letras, numeros, _, . ou -.", 2)
            payload["username"] = args.username
    elif args.no_auth:
        payload["credentials"] = "none"
    else:
        if len(args.username) > 58:
            raise CliError("Usuario do lote deve ter no maximo 58 caracteres.", 2)
        payload.update(credentials="common", username=args.username, password=read_password(args, stdin))
    return payload, interactive

def run_batch(args, token, stdin, stdout, stderr, opener):
    payload, interactive = batch_payload(args, stdin, stderr)
    if interactive:
        start = payload.get("start_port", "inicio da faixa")
        print(f"Criar {payload['count']} proxies {payload['protocol']} a partir da porta {start}, "
              f"credenciais {payload['credentials']}.", file=stderr)
    confirm(args, stdin, stderr, warning=None)
    output_file = OutputFile(args.output_file, args.force) if args.output_file else None
    try:
        status_code, body = request("POST", "/proxies/batch", token, payload, opener)
        if status_code not in (201, 207):
            raise CliError(f"API retornou HTTP {status_code}; esperado 201 ou 207.", 5)
        created, failed = batch_view(decode_json(body))
    except BaseException:
        if output_file:
            output_file.discard()
        raise
    if payload["credentials"] == "common":
        created = [{**item, "password": payload["password"]} for item in created]
    emit(created, args, stdout, stderr, output_file)
    print(f"Criados: {len(created)}; falhas: {len(failed)}.", file=stderr)
    if failed:
        print("Portas com falha: " + ", ".join(map(str, failed)), file=stderr)
        raise CliError("Lote parcial: alguns proxies nao foram criados.", 7)

def run_edit(args, token, stdin, stdout, stderr, opener):
    if args.password_stdin and not args.username:
        raise CliError("--password-stdin exige --username.", 2)
    if args.new_port is None and args.protocol is None and not args.username and not args.no_auth:
        raise CliError("Nada a alterar: use --new-port, --protocol, --username ou --no-auth.", 2)
    payload = {}
    if args.new_port is not None:
        payload["port"] = args.new_port
    if args.protocol is not None:
        payload["protocol"] = args.protocol
    confirm(args, stdin, stderr)
    if args.no_auth:
        payload.update(username=None, password=None)
    elif args.username:
        payload.update(username=args.username, password=read_password(args, stdin))
    status_code, body = request("GET", f"/proxies/{args.port}", token, opener=opener)
    if status_code != 200:
        raise CliError(f"API retornou HTTP {status_code}; esperado 200.", 5)
    current = decode_json(body)
    proxy_id = current.get("id") if isinstance(current, dict) else None
    if not isinstance(proxy_id, str) or not ID_RE.fullmatch(proxy_id):
        raise CliError("API retornou um id invalido.", 5)
    # If-Match: a concurrent delete+recreate on this port answers 412 instead of editing the heir.
    status_code, body = request("PATCH", f"/proxies/{args.port}", token, payload, opener,
                                headers={"If-Match": proxy_id})
    if status_code != 200:
        raise CliError(f"API retornou HTTP {status_code}; esperado 200.", 5)
    render("edit", proxy_view(decode_json(body)), args.output, stdout)

def run_export(args, token, stdin, stdout, stderr, opener):
    output_file = OutputFile(args.output_file, args.force) if args.output_file else None
    try:
        status_code, body = request("GET", "/proxies", token, opener=opener)
        records = parse_response("list", status_code, body)
    except BaseException:
        if output_file:
            output_file.discard()
        raise
    emit(records, args, stdout, stderr, output_file)
    with_auth = sum(1 for item in records if item["username"])
    if with_auth:
        print(f"Aviso: {with_auth} proxies com autenticacao exportados sem senha; a API nao devolve "
              "senhas existentes (elas so aparecem na criacao).", file=stderr)

def execute(args, token, stdin, stdout, stderr, opener=None):
    if args.command == "batch":
        return run_batch(args, token, stdin, stdout, stderr, opener)
    if args.command == "edit":
        return run_edit(args, token, stdin, stdout, stderr, opener)
    if args.command == "export":
        return run_export(args, token, stdin, stdout, stderr, opener)
    if args.command == "list":
        status_code, body = request("GET", "/proxies", token, opener=opener)
        result = parse_response("list", status_code, body)
    elif args.command == "create":
        confirm(args, stdin, stderr, warning=None)
        password = read_password(args, stdin)
        payload = {"protocol": args.protocol}
        if args.port is not None:
            payload["port"] = args.port
        if args.username is not None:
            payload.update(username=args.username, password=password)
        status_code, body = request("POST", "/proxies", token, payload, opener)
        result = parse_response("create", status_code, body)
    elif args.command == "rotate":
        confirm(args, stdin, stderr)
        status_code, body = request("POST", f"/proxies/{args.port}/rotate", token, opener=opener)
        result = parse_response("rotate", status_code, body)
    else:
        confirm(args, stdin, stderr)
        status_code, body = request("DELETE", f"/proxies/{args.port}", token, opener=opener)
        result = parse_response("delete", status_code, body, args.port)
    render(args.command, result, args.output, stdout)

def main(argv=None, stdin=None, stdout=None, stderr=None, env_file=ENV_FILE,
         expected_uid=0, effective_uid=None, opener=None):
    stdin = stdin or sys.stdin
    stdout = stdout or sys.stdout
    stderr = stderr or sys.stderr
    parser = build_parser()
    args = parser.parse_args(argv)
    uid = os.geteuid() if effective_uid is None else effective_uid
    if uid != 0:
        print("Erro: execute os comandos operacionais com sudo.", file=stderr)
        return 3
    try:
        token = load_token(env_file, expected_uid)
        execute(args, token, stdin, stdout, stderr, opener)
        return 0
    except CliError as exc:
        print(f"Erro: {exc}", file=stderr)
        return exc.exit_code
    except KeyboardInterrupt:
        print("\nOperacao interrompida.", file=stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
